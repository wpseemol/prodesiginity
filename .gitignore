# Root monorepo ignores (package-specific rules live in
# frontend/.gitignore, backend/.gitignore, dashboard/.gitignore)

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# pnpm
.pnpm-store/
.pnpm-debug.log*

# Env & secrets
.env
.env.*
!.env.example
!.env.*.example
!.env.dev

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/settings.json.example
*.swp
*.swo

# Build / output / deploy artifacts
dist/
build/
backend/dist/
frontend/out/
frontend/upload/
dashboard/dist/
*.tar.gz
*.zip
!frontend/public/**

# Recovery / local scratch (do not commit)
backend-recovered/
backend-old-api-backup/
.vercel
