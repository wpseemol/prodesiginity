PORT=4000
NODE_ENV=development

# Optional public base shown on GET / and GET /api
# PUBLIC_API_URL=https://api.prodesignity.com

# Comma-separated frontend origins (production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://prodesignity.com,https://dashboard.prodesignity.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=_admin123
DB_NAME=pro_designity_db
DATABASE_URL=mysql://admin:_admin123@127.0.0.1:3306/pro_designity_db

JWT_SECRET=change-me-in-production

# Optional — override demo credentials used by `npm run db:seed` / `db:seed:deploy`
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_EMAIL=admin@prodesignity.com
# SEED_ADMIN_PASSWORD=change-me-strong
# SEED_EMPLOYEE_USERNAME=employee
# SEED_EMPLOYEE_EMAIL=employee@prodesignity.com
# SEED_EMPLOYEE_PASSWORD=change-me-strong

# Optional mail
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# TARGET_MAIL=
