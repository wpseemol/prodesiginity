{
  "name": "prodesignity-api",
  "version": "1.0.0",
  "description": "ProDesignity Express API (standalone)",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:deploy": "tsx scripts/seed-deploy.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "db:setup:deploy": "prisma generate && prisma db push && tsx scripts/seed-deploy.ts",
    "db:seed-homepage": "tsx scripts/ensure-homepage.ts",
    "db:seed-team-settings": "tsx scripts/ensure-team-settings.ts",
    "db:ensure-team-profile": "tsx scripts/ensure-team-profile-fields.ts",
    "db:ensure-user-status": "tsx scripts/ensure-user-status.ts",
    "db:ensure-careers": "tsx scripts/ensure-careers-mail.ts",
    "db:ensure-careers-content": "tsx scripts/ensure-careers-content.ts",
    "db:ensure-tracking": "tsx scripts/ensure-tracking-settings.ts",
    "db:ensure-services": "tsx scripts/ensure-services.ts",
    "db:ensure-industries": "tsx scripts/ensure-industries.ts",
    "db:ensure-auth-avatars": "tsx scripts/ensure-auth-avatars.ts",
    "db:ensure-site-config": "tsx scripts/ensure-site-config.ts",
    "db:ensure-blog": "prisma db execute --file prisma/sql/blog-tables.sql && tsx scripts/ensure-blog-columns.ts",
    "db:import-blog": "tsx scripts/import-static-blog.ts",
    "geoip:download": "tsx scripts/download-geolite2.ts",
    "services:export-seed": "tsx scripts/export-services-seed.ts",
    "industries:export-seed": "tsx scripts/export-industries-seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@maxmind/geoip2-node": "^7.1.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/tar": "^6.1.13",
    "@types/validator": "^13.15.10",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.4",
    "multer": "^2.3.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^9.0.6",
    "prisma": "7.10.0",
    "resend": "^6.25.0",
    "tar": "^7.5.22",
    "typescript": "^5.9.3",
    "validator": "^13.15.35",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.13"
  }
}
