PORT=4000
NODE_ENV=development

# Optional public base shown on GET / and GET /api
# PUBLIC_API_URL=https://api.prodesignity.com

# Comma-separated frontend origins (production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://prodesignity.com,https://dashboard.prodesignity.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=_admin123
DB_NAME=pro_designity_db
DATABASE_URL=mysql://admin:_admin123@127.0.0.1:3306/pro_designity_db

JWT_SECRET=change-me-in-production

# Optional — create a real admin on `pnpm run db:seed` (no demos by default)
# SEED_ADMIN_NAME=Admin
# SEED_ADMIN_USERNAME=yourname
# SEED_ADMIN_EMAIL=you@prodesignity.com
# SEED_ADMIN_PASSWORD=YourStrongPass1!

# Outgoing mail (Resend or SMTP) is configured in Dashboard → Settings → Mail.
# Key used to encrypt the saved API key / SMTP password. Any long random string;
# keep it stable or saved credentials have to be re-entered.
SETTINGS_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Google sign-in for the client login page (OAuth 2.0 Web client ID).
# Same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
