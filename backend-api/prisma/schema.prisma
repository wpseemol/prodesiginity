generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id            Int            @id @default(autoincrement())
  fullName      String         @map("full_name")
  username      String         @unique
  email         String         @unique
  password      String
  /// Google account `sub` for clients who sign in with Google.
  googleId      String?        @unique @map("google_id") @db.VarChar(64)
  /// Profile picture from the user's Google account, refreshed on each Google sign-in.
  googlePictureUrl String?     @map("google_picture_url") @db.VarChar(512)
  role          Role           @default(user)
  photoId       Int?           @map("photo_id")
  photo         Photo?         @relation("UserProfilePhoto", fields: [photoId], references: [id], onDelete: SetNull)
  photos        Photo[]        @relation("UserPhotos")
  /// Admin-provided avatar the user picked instead of an uploaded photo.
  avatarPresetId Int?          @map("avatar_preset_id")
  avatarPreset  AvatarPreset?  @relation(fields: [avatarPresetId], references: [id], onDelete: SetNull)
  teamMember    TeamMember?
  /// Set by an admin to block sign-in and token refresh.
  disabledAt    DateTime?      @map("disabled_at")
  created_at    DateTime       @default(now())
  refreshTokens RefreshToken[]
  blogPosts     BlogPost[]     @relation("BlogPostAuthor")
  notifications Notification[] @relation("UserNotifications")
  applicationReplies ApplicationReply[] @relation("ApplicationReplySender")

  @@map("users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Photo {
  id           Int      @id @default(autoincrement())
  url          String
  altText      String?  @map("alt_text")
  description  String?
  ownerId      Int?     @map("owner_id")
  owner        User?    @relation("UserPhotos", fields: [ownerId], references: [id], onDelete: Cascade)
  profileUsers User[]   @relation("UserProfilePhoto")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([ownerId])
  @@map("photos")
}

/// Avatar images an admin uploads (max 5) for staff and clients to choose from.
model AvatarPreset {
  id        Int      @id @default(autoincrement())
  url       String   @db.VarChar(512)
  label     String?  @db.VarChar(80)
  sortOrder Int      @default(0) @map("sort_order")
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sortOrder])
  @@map("avatar_presets")
}

enum Role {
  admin
  user
  employer
}

/// Editable homepage CMS blocks. Each row is one section (hero, pricing, …);
/// `content` holds the section's JSON payload consumed by the frontend.
model HomePageSection {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(64)
  label     String   @db.VarChar(128)
  content   Json
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("homepage_sections")
}

/// Homepage / about team roster managed by admin (add / delete).
model TeamMember {
  id         Int      @id @default(autoincrement())
  slug       String   @unique @db.VarChar(80)
  name       String   @db.VarChar(120)
  role       String   @db.VarChar(160)
  tagline    String?  @db.Text
  /** Longer public bio shown on marketing site (staff can edit). */
  description String? @db.Text
  /** Login email shown in admin; linked staff user when set. */
  email      String?  @unique @db.VarChar(254)
  /** Optional portrait; without one the avatar (then initials) is shown. */
  photoUrl   String?  @map("photo_url") @db.VarChar(512)
  /** SEO: HTML img alt / description */
  photoAlt   String?  @map("photo_alt") @db.VarChar(255)
  /** SEO: HTML img title */
  photoTitle String?  @map("photo_title") @db.VarChar(160)
  /** Separate avatar image (illustrated / 3D avatar). Falls back to the photo. */
  avatarUrl    String? @map("avatar_url") @db.VarChar(512)
  /** auto (style default) | circle | squircle | hexagon | blob */
  avatarShape  String  @default("auto") @map("avatar_shape") @db.VarChar(16)
  /** Public profile theme: auto | lead | designer | graphic | developer | animator | marketing | people */
  profileStyle String  @default("auto") @map("profile_style") @db.VarChar(24)
  /** { facebook, instagram, linkedin, behance, dribbble, artstation, x, github, youtube, website } → URL */
  socials      Json?
  /** Up to 12 short skill labels. */
  skills       Json?
  isLead     Boolean  @default(false) @map("is_lead")
  sortOrder  Int      @default(0) @map("sort_order")
  userId     Int?     @unique @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  blogBylines BlogPost[] @relation("BlogPostByline")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("team_members")
}

/// Singleton site branding (key = "default"): favicon + login screen copy/logo.
model SiteSetting {
  id             Int      @id @default(autoincrement())
  key            String   @unique @default("default") @db.VarChar(32)
  siteName       String?  @map("site_name") @db.VarChar(120)
  faviconUrl     String?  @map("favicon_url") @db.VarChar(512)
  loginTitle     String?  @map("login_title") @db.VarChar(160)
  loginSubtitle  String?  @map("login_subtitle") @db.VarChar(255)
  loginBadgeText String?  @map("login_badge_text") @db.VarChar(80)
  loginLogoUrl   String?  @map("login_logo_url") @db.VarChar(512)

  /// Browser + server tracking (Meta Pixel, GA4, CAPI, Enhanced Conversions).
  trackingEnabled                 Boolean  @default(false) @map("tracking_enabled")
  metaPixelId                     String?  @map("meta_pixel_id") @db.VarChar(64)
  googleMeasurementId             String?  @map("google_measurement_id") @db.VarChar(64)
  googleAdsId                     String?  @map("google_ads_id") @db.VarChar(64)
  metaCapiAccessToken             String?  @map("meta_capi_access_token") @db.Text
  metaCapiTestEventCode           String?  @map("meta_capi_test_event_code") @db.VarChar(64)
  googleAdsConversionLabel        String?  @map("google_ads_conversion_label") @db.VarChar(128)
  googleAdsCustomerId             String?  @map("google_ads_customer_id") @db.VarChar(32)
  googleEnhancedConversionsApiKey String?  @map("google_enhanced_conversions_api_key") @db.Text

  /// "Sign in with Google" OAuth client. The secret is AES-GCM encrypted (lib/secretBox).
  googleClientId     String? @map("google_client_id") @db.VarChar(255)
  googleClientSecret String? @map("google_client_secret") @db.Text

  /// Editable marketing site config (contact, social, legal, …).
  siteConfig Json? @map("site_config")

  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("site_settings")
}

/// First-party page views for dashboard overview (country / device / path).
model PageVisit {
  id          Int      @id @default(autoincrement())
  path        String   @db.VarChar(512)
  referrer    String?  @db.VarChar(512)
  country     String?  @db.VarChar(80)
  countryCode String?  @map("country_code") @db.VarChar(8)
  deviceType  String?  @map("device_type") @db.VarChar(32)
  browser     String?  @db.VarChar(64)
  sessionId   String?  @map("session_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([countryCode])
  @@index([deviceType])
  @@map("page_visits")
}

/// Service category (nav mega-menu level 1).
model ServiceGroup {
  id        Int       @id @default(autoincrement())
  slug      String    @unique @db.VarChar(80)
  title     String    @db.VarChar(160)
  blurb     String    @db.VarChar(512)
  icon      String    @db.VarChar(64)
  sortOrder Int       @default(0) @map("sort_order")
  services  Service[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("service_groups")
}

/// Individual service (Types of Work We Do + /services pages).
model Service {
  id           Int          @id @default(autoincrement())
  slug         String       @unique @db.VarChar(120)
  title        String       @db.VarChar(200)
  groupId      Int          @map("group_id")
  group        ServiceGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  icon         String       @db.VarChar(64)
  tagline      String       @db.VarChar(255)
  summary      String       @db.Text
  intro        Json
  deliverables Json
  idealFor     Json         @map("ideal_for")
  process      Json
  faqs         Json
  timeline     String       @db.VarChar(120)
  startingAt   String       @map("starting_at") @db.VarChar(120)
  accent       Json
  seo          Json
  sortOrder    Int          @default(0) @map("sort_order")
  published    Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([groupId])
  @@index([sortOrder])
  @@index([published])
  @@map("services")
}

/// Target industry (nav "Industries" menu + /industries/[slug] landing pages).
model Industry {
  id           Int      @id @default(autoincrement())
  slug         String   @unique @db.VarChar(120)
  /// Short label used in the menu and cards, e.g. "HVAC".
  title        String   @db.VarChar(160)
  /// Page <h1>, e.g. "Websites & Marketing for HVAC Companies".
  headline     String   @db.VarChar(255)
  icon         String   @db.VarChar(64)
  tagline      String   @db.VarChar(255)
  summary      String   @db.Text
  heroImage    String?  @map("hero_image") @db.VarChar(512)
  heroImageAlt String?  @map("hero_image_alt") @db.VarChar(255)
  /// string[] — one entry per paragraph.
  intro        Json
  /// string[] — the kinds of businesses the page targets.
  audience     Json
  /// { title, body }[] — pain points the industry has online.
  challenges   Json
  /// { title, body }[] — how the studio solves them.
  solutions    Json
  /// string[] — service slugs shown as "services for this industry".
  services     Json
  /// { value, label }[]
  stats        Json
  faqs         Json
  ctaTitle     String?  @map("cta_title") @db.VarChar(200)
  ctaBody      String?  @map("cta_body") @db.VarChar(600)
  accent       Json
  seo          Json
  sortOrder    Int      @default(0) @map("sort_order")
  published    Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@index([published])
  @@map("industries")
}

/// Blog category (filter chips on /blog). Image and icon are optional.
model BlogCategory {
  id          Int        @id @default(autoincrement())
  slug        String     @unique @db.VarChar(80)
  name        String     @db.VarChar(120)
  description String?    @db.VarChar(512)
  imageUrl    String?    @map("image_url") @db.VarChar(512)
  icon        String?    @db.VarChar(64)
  sortOrder   Int        @default(0) @map("sort_order")
  posts       BlogPost[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("blog_categories")
}

enum BlogStatus {
  draft
  published
}

/// Blog article. `body` is an array of typed blocks (same shape the website
/// renders), never raw HTML.
model BlogPost {
  id           Int          @id @default(autoincrement())
  slug         String       @unique @db.VarChar(160)
  title        String       @db.VarChar(200)
  excerpt      String       @db.VarChar(600)
  categoryId   Int          @map("category_id")
  category     BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  authorId     Int?         @map("author_id")
  author       User?        @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// Team member shown in the byline. Set when the writer has no login, or an
  /// admin publishes on someone's behalf; otherwise the byline is the author.
  bylineMemberId Int?        @map("byline_member_id")
  bylineMember   TeamMember? @relation("BlogPostByline", fields: [bylineMemberId], references: [id], onDelete: SetNull)
  coverImage   String?      @map("cover_image") @db.VarChar(512)
  coverAlt     String?      @map("cover_alt") @db.VarChar(255)
  videoUrl     String?      @map("video_url") @db.VarChar(512)
  accent       String       @default("indigo") @db.VarChar(16)
  icon         String?      @db.VarChar(64)
  body         Json
  keyTakeaways Json         @map("key_takeaways")
  faqs         Json
  tags         Json
  /// Service slugs listed under the article as "related services".
  relatedServices Json?     @map("related_services")
  seo          Json
  featured     Boolean      @default(false)
  status       BlogStatus   @default(draft)
  publishedAt  DateTime?    @map("published_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([authorId])
  @@index([bylineMemberId])
  @@index([status, publishedAt])
  @@map("blog_posts")
}

/// Open position listed on /careers. Applicants pick it by title, so titles
/// must stay unique and match the apply form's role rules.
model CareerJob {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(120)
  department  String   @db.VarChar(80)
  type        String   @db.VarChar(40)
  location    String   @db.VarChar(80)
  experience  String   @db.VarChar(40)
  salary      String   @db.VarChar(60)
  description String   @db.Text
  published   Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@index([published])
  @@map("career_jobs")
}

/// Singleton (key = "default") holding the editable /careers page copy.
model CareersPage {
  id        Int      @id @default(autoincrement())
  key       String   @unique @default("default") @db.VarChar(32)
  content   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("careers_page")
}

/// Application sent from the /careers form. The CV lives in private storage
/// (never under /uploads) and is only streamed to admins.
model JobApplication {
  id           Int                @id @default(autoincrement())
  name         String             @db.VarChar(80)
  email        String             @db.VarChar(254)
  phone        String             @db.VarChar(20)
  city         String             @db.VarChar(60)
  jobTitle     String             @map("job_title") @db.VarChar(120)
  experience   String             @db.VarChar(20)
  portfolioUrl String?            @map("portfolio_url") @db.VarChar(300)
  coverLetter  String?            @map("cover_letter") @db.Text
  resumeFile   String             @map("resume_file") @db.VarChar(120)
  resumeName   String             @map("resume_name") @db.VarChar(160)
  resumeMime   String             @map("resume_mime") @db.VarChar(100)
  resumeSize   Int                @map("resume_size")
  /// new | reviewing | shortlisted | interview | offered | hired | rejected
  status       String             @default("new") @db.VarChar(20)
  rating       Int?               @db.TinyInt
  notes        String?            @db.Text
  ipHash       String?            @map("ip_hash") @db.VarChar(64)
  userAgent    String?            @map("user_agent") @db.VarChar(255)
  readAt       DateTime?          @map("read_at")
  replies      ApplicationReply[]
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@map("job_applications")
}

/// Email sent to an applicant from the dashboard.
model ApplicationReply {
  id            Int            @id @default(autoincrement())
  applicationId Int            @map("application_id")
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subject       String         @db.VarChar(200)
  body          String         @db.Text
  /// sent | failed
  status        String         @db.VarChar(16)
  provider      String?        @db.VarChar(16)
  error         String?        @db.VarChar(500)
  sentById      Int?           @map("sent_by_id")
  sentBy        User?          @relation("ApplicationReplySender", fields: [sentById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([applicationId])
  @@map("application_replies")
}

/// Dashboard notification. `userId = null` is shared by every admin.
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int?      @map("user_id")
  user      User?     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(160)
  body      String?   @db.VarChar(500)
  link      String?   @db.VarChar(255)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

/// Singleton outgoing-mail configuration. Secrets are AES-GCM encrypted.
model MailSetting {
  id                  Int       @id @default(autoincrement())
  key                 String    @unique @default("default") @db.VarChar(32)
  /// none | resend | smtp
  provider            String    @default("none") @db.VarChar(16)
  fromName            String?   @map("from_name") @db.VarChar(120)
  fromEmail           String?   @map("from_email") @db.VarChar(254)
  replyTo             String?   @map("reply_to") @db.VarChar(254)
  notifyEmail         String?   @map("notify_email") @db.VarChar(254)
  resendApiKey        String?   @map("resend_api_key") @db.Text
  smtpPreset          String?   @map("smtp_preset") @db.VarChar(32)
  smtpHost            String?   @map("smtp_host") @db.VarChar(255)
  smtpPort            Int?      @map("smtp_port")
  smtpSecure          Boolean   @default(false) @map("smtp_secure")
  smtpUser            String?   @map("smtp_user") @db.VarChar(254)
  smtpPass            String?   @map("smtp_pass") @db.Text
  careersAutoReply    Boolean   @default(true) @map("careers_auto_reply")
  notifyOnApplication Boolean   @default(true) @map("notify_on_application")
  lastTestAt          DateTime? @map("last_test_at")
  lastTestOk          Boolean?  @map("last_test_ok")
  lastError           String?   @map("last_error") @db.VarChar(500)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("mail_settings")
}
