# Public site URL (canonicals, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://prodesignity.com

# Express API (homepage CMS, auth, team, services, settings)
NEXT_PUBLIC_API_URL=https://api.prodesignity.com/api

# Staff dashboard (Vite) — admin / employee login
# Local: http://localhost:5173  |  Production: https://dashboard.prodesignity.com
NEXT_PUBLIC_STAFF_PORTAL_URL=http://localhost:5173

# Google sign-in on /login (OAuth 2.0 Web client ID from Google Cloud Console).
# Add the site origin(s) to "Authorized JavaScript origins". The API needs the
# same value as GOOGLE_CLIENT_ID.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
